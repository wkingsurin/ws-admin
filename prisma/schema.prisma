generator client {
  provider = "prisma-client"
  output   = "../prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  products Product[]
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   Variant  @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
}

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  products Product[]
}

model Checkout {
  id             String          @id @default(cuid())
  userId         String          @unique
  address        String?
  city           String?
  country        String?
  postalCode     String?
  paymentMethod  PaymentMethod?
  deliveryMethod DeliveryMethod?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, productId])
}

model LastSeenProduct {
  id        String   @id @default(cuid())
  userId    String
  productId String
  viewedAt  DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, viewedAt(sort: Desc)])
}

model Order {
  id                 String         @id @default(cuid())
  orderNumber        String         @unique
  userId             String?
  status             OrderStatus    @default(PENDING)
  customerName       String
  customerEmail      String
  shippingAddress    String
  shippingCity       String
  shippingCountry    String
  shippingPostalCode String
  paymentMethod      PaymentMethod
  deliveryMethod     DeliveryMethod
  currency           String
  totalItemsPrice    Int
  discountAmount     Int            @default(0)
  deliveryPrice      Int            @default(0)
  totalPrice         Int
  isPaid             Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  user               User?          @relation(fields: [userId], references: [id])
  items              OrderItem[]
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  productId     String
  variantId     String
  title         String
  sku           String
  price         Int
  quantity      Int
  selectedColor String
  selectedSize  String
  image         String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  order         Order    @relation(fields: [orderId], references: [id])
}

model Product {
  id               String            @id @default(cuid())
  title            String
  slug             String            @unique
  description      String
  currency         String
  isAvailable      Boolean           @default(true)
  isNew            Boolean           @default(false)
  brandId          String
  categoryId       String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  favorites        Favorite[]
  lastSeenProducts LastSeenProduct[]
  brand            Brand             @relation(fields: [brandId], references: [id])
  category         Category          @relation(fields: [categoryId], references: [id])
  productColors    ProductColor[]
  variants         Variant[]
}

model ProductColor {
  id        String         @id @default(cuid())
  productId String
  name      String
  slug      String
  product   Product        @relation(fields: [productId], references: [id])
  images    ProductImage[]
  variants  Variant[]

  @@unique([productId, name])
  @@index([productId])
}

model ProductImage {
  id      String       @id @default(cuid())
  colorId String
  src     String
  userId  String?
  color   ProductColor @relation(fields: [colorId], references: [id])
  user    User?        @relation(fields: [userId], references: [id])
}

model User {
  id               String            @id @default(cuid())
  telegramId       BigInt?           @unique
  name             String?
  email            String            @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  cart             Cart?
  checkout         Checkout?
  favorites        Favorite[]
  lastSeenProducts LastSeenProduct[]
  orders           Order[]
  image            ProductImage[]
  address          UserAddress?
}

model UserAddress {
  id         String   @id @default(cuid())
  userId     String   @unique
  recipient  String?
  country    String?
  city       String?
  street     String?
  postalCode String?
  phone      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Variant {
  id        String       @id @default(cuid())
  productId String
  colorId   String
  sku       String       @unique
  price     Int
  oldPrice  Int?
  stock     Int          @default(0)
  size      String
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  cartItems CartItem[]
  color     ProductColor @relation(fields: [colorId], references: [id])
  product   Product      @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([size])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

enum DeliveryMethod {
  COURIER
  PICKUP
  POST
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CARD
  CASH
  PAYPAL
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}
